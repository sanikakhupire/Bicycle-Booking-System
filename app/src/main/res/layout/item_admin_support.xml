<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTicketSubject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"
                tools:text="Flat Tyre on Bicycle BIK-1002" />

            <TextView
                android:id="@+id/tvTicketStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#FFF3E0"
                android:textColor="#E65100"
                tools:text="OPEN" />
        </LinearLayout>

        <!-- Category & Priority Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvTicketCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#616161"
                android:layout_marginEnd="6dp"
                tools:text="DAMAGED_BICYCLE" />

            <TextView
                android:id="@+id/tvTicketPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFEBEE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#C62828"
                tools:text="URGENT" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTicketDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#424242"
            android:layout_marginTop="6dp"
            tools:text="Rear tire was punctured near Pune Station dock." />

        <!-- Optional Context (Booking / Bicycle / Disputed amount) -->
        <TextView
            android:id="@+id/tvTicketContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#E65100"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:text="Linked: Booking #BK-991 • Disputed: ₹70.00" />

        <TextView
            android:id="@+id/tvTicketUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp"
            tools:text="Reported by Rajesh Sharma • +91 98765 43210" />

        <TextView
            android:id="@+id/tvTicketStaff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#1B5E20"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            tools:text="Assigned Staff: Rohan (Fleet Support)" />

        <TextView
            android:id="@+id/tvTicketNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8F5E9"
            android:padding="8dp"
            android:textSize="12sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            tools:text="Resolution: Replacement bicycle dispatched." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginVertical="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTicketDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#9E9E9E"
                tools:text="23 Nov 2026, 11:30 AM" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResolveTicket"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Triage / Actions"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#1B5E20"
                app:cornerRadius="6dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
