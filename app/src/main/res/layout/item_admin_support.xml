<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTicketSubject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"
                tools:text="Flat Tyre on Bicycle BIK-1002" />

            <TextView
                android:id="@+id/tvTicketStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#FFF3E0"
                android:textColor="#E65100"
                tools:text="OPEN" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTicketCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#616161"
            android:layout_marginTop="6dp"
            tools:text="DAMAGED_BICYCLE" />

        <TextView
            android:id="@+id/tvTicketDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#424242"
            android:layout_marginTop="6dp"
            tools:text="Rear tire was punctured near Pune Station dock." />

        <TextView
            android:id="@+id/tvTicketUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp"
            tools:text="Reported by Rajesh Sharma • +91 98765 43210" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginVertical="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTicketDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#9E9E9E"
                tools:text="23 Nov 2026, 11:30 AM" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResolveTicket"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resolve Grievance"
                android:textSize="12sp"
                android:textColor="#1B5E20" />
        </LinearLayout>

        <!-- Admin resolution notes (if resolved) -->
        <TextView
            android:id="@+id/tvTicketNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8F5E9"
            android:padding="8dp"
            android:textSize="11sp"
            android:textColor="#1B5E20"
            android:visibility="gone"
            tools:text="Resolution: Bicycle retrieved by handler and moved to maintenance." />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
