<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="96dp">

        <!-- Modern Hero Header with Gradient Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_brand_gradient"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Avatar Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    app:cardCornerRadius="42dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/white"
                    app:strokeWidth="3dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#D1FAE5">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="center"
                            android:contentDescription="Profile picture"
                            android:src="@drawable/ic_person_outline"
                            app:tint="@color/colorPrimary" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Name & Verification Tag -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.01"
                    android:text="User Name"
                    android:textColor="@color/white"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/circle_dot"
                    android:backgroundTint="#20FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="● Verified Rider (India)"
                    android:textColor="#ECFDF5"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- View Mode -->
        <LinearLayout
            android:id="@+id/layoutView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp">

            <!-- Personal Contact Details Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_email_outline"
                            app:tint="@color/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Registered Email"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="#F1F5F9" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_phone_outline"
                            app:tint="@color/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Mobile Number"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Edit Profile Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProfile"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="@string/edit_profile"
                android:textColor="@color/colorPrimary"
                app:icon="@drawable/ic_person_outline"
                app:iconGravity="textStart"
                app:iconTint="@color/colorPrimary"
                app:strokeColor="@color/colorPrimary" />

            <!-- Section: Rides & Rewards -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:text="RIDES &amp; REWARDS"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoyaltyRewards"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="start|center_vertical"
                android:text="Loyalty Rewards &amp; Points"
                android:textColor="#D97706"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconTint="#D97706"
                app:strokeColor="#FDE68A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReferral"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:gravity="start|center_vertical"
                android:text="Refer &amp; Earn Rewards"
                android:textColor="@color/colorPrimary"
                app:icon="@drawable/ic_bicycle"
                app:iconGravity="textStart"
                app:iconTint="@color/colorPrimary"
                app:strokeColor="#A7F3D0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPaymentHistory"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:gravity="start|center_vertical"
                android:text="Payment History &amp; Invoices"
                android:textColor="@color/colorTextPrimary"
                app:icon="@drawable/ic_history"
                app:iconGravity="textStart"
                app:iconTint="@color/colorTextSecondary"
                app:strokeColor="#E2E8F0" />

            <!-- Section: Support & Safety -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:text="SUPPORT &amp; SAFETY"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotifications"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="start|center_vertical"
                android:text="Notifications &amp; Alerts"
                android:textColor="@color/colorTextPrimary"
                app:icon="@drawable/ic_speedometer"
                app:iconGravity="textStart"
                app:iconTint="@color/colorTextSecondary"
                app:strokeColor="#E2E8F0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHelpCenter"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:gravity="start|center_vertical"
                android:text="Help Center &amp; Support"
                android:textColor="@color/colorPrimary"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconTint="@color/colorPrimary"
                app:strokeColor="#A7F3D0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportBicycleDamage"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:gravity="start|center_vertical"
                android:text="Report Bicycle Damage"
                android:textColor="@color/colorUnavailable"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart"
                app:iconTint="@color/colorUnavailable"
                app:strokeColor="#FECACA" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLegalPrivacy"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:gravity="start|center_vertical"
                android:text="Privacy Policy &amp; Legal Rights"
                android:textColor="@color/colorTextSecondary"
                app:icon="@drawable/ic_lock_outline"
                app:iconGravity="textStart"
                app:iconTint="@color/colorTextSecondary"
                app:strokeColor="#E2E8F0" />

            <!-- Operations / Admin Section -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminPanel"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/colorAccent"
                android:text="Admin Management Dashboard"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHandlerPortal"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="Cycle Handler Operations Portal"
                android:visibility="gone" />

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/colorUnavailable"
                android:text="@string/logout" />
        </LinearLayout>

        <!-- Edit Mode -->
        <LinearLayout
            android:id="@+id/layoutEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/CardStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Edit Personal Details"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="18sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilName"
                        style="@style/InputField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name"
                        app:boxBackgroundColor="@color/colorSurface"
                        app:boxStrokeColor="@color/box_stroke_selector"
                        app:startIconDrawable="@drawable/ic_person_outline"
                        app:startIconTint="@color/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="textPersonName"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPhone"
                        style="@style/InputField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Phone Number"
                        app:boxBackgroundColor="@color/colorSurface"
                        app:boxStrokeColor="@color/box_stroke_selector"
                        app:prefixText="+91 "
                        app:prefixTextColor="@color/colorTextPrimary"
                        app:startIconDrawable="@drawable/ic_phone_outline"
                        app:startIconTint="@color/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="phone"
                            android:maxLength="10"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#FEF2F2"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textColor="@color/colorUnavailable"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/colorPrimary"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSave"
                        style="@style/PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/save" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancel"
                        style="@style/SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/cancel" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
