<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notification Preferences"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Choose which alerts and communication channels you want to receive."
            android:textSize="13sp"
            android:textColor="#757575" />

        <!-- Master Switch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPushEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Push Notifications"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:checked="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Receive alerts on device lockscreen and notification shade."
                    android:textSize="12sp"
                    android:textColor="#757575" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Category Preferences Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alert Categories"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:layout_marginBottom="10dp" />

                <!-- Booking Alerts -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBookingAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bookings &amp; Reservation Hold Reminders"
                    android:textSize="14sp"
                    android:checked="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#EEEEEE" />

                <!-- Ride Tracking Alerts -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchRideTrackingAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ride Duration &amp; Trip Updates"
                    android:textSize="14sp"
                    android:checked="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#EEEEEE" />

                <!-- Billing & Payments -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBillingAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Invoices, UPI Receipts &amp; Refund Status"
                    android:textSize="14sp"
                    android:checked="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#EEEEEE" />

                <!-- Promotions & Coupons -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPromotions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Discount Coupons &amp; Offers"
                    android:textSize="14sp"
                    android:checked="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#EEEEEE" />

                <!-- Maintenance & Safety -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMaintenanceAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bicycle Safety &amp; Grounding Advisories"
                    android:textSize="14sp"
                    android:checked="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#EEEEEE" />

                <!-- Support Ticket Updates -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSupportAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Support Ticket Resolutions &amp; Replies"
                    android:textSize="14sp"
                    android:checked="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePreferences"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Save Preferences"
            android:textSize="15sp"
            app:cornerRadius="10dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
