<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.BicycleBookingApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.BicycleBookingApp" parent="Base.Theme.BicycleBookingApp" />

    <!-- Splash screen theme (no action bar, full screen) -->
    <style name="Theme.BicycleBookingApp.Splash" parent="Theme.BicycleBookingApp">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/colorPrimaryDark</item>
    </style>

    <!-- Modern Card style with subtle border & shadow -->
    <style name="CardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/colorDivider</item>
        <item name="cardBackgroundColor">@color/colorCardBackground</item>
    </style>

    <!-- Modern Primary Action Button -->
    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Modern Secondary / Outlined Button -->
    <style name="SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">50dp</item>
    </style>

    <!-- Sleek Input Field with Rounded Squircle Outlines -->
    <style name="InputField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/box_stroke_selector</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/colorSurface</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="placeholderTextColor">@color/colorTextHint</item>
        <item name="startIconTint">@color/colorTextSecondary</item>
        <item name="endIconTint">@color/colorTextSecondary</item>
    </style>

</resources>
