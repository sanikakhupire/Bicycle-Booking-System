rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Support grievance attachments (photos, receipts, screenshots)
    match /support_attachments/{ticketId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Bicycle maintenance and repair inspection photos
    match /maintenance/{bicycleId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // User profile images
    match /users/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Secure Default: Deny write to any unmapped paths
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: false;
    }
  }
}
