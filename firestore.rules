rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() &&
             (getUserData().isAdmin == true || getUserData().role == 'ADMIN');
    }

    function isHandler() {
      return isAuthenticated() &&
             (getUserData().role == 'HANDLER' || isAdmin());
    }

    // ─── users ───────────────────────────────────────────────────────────────
    // Regular users can read and edit only their own document.
    // Privileged fields (isAdmin, role) CANNOT be set or modified by regular users.
    // Admins have full access.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isHandler() || isAdmin();
      
      // Prevent privilege escalation on registration
      allow create: if isOwner(userId) &&
                       (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
                       (!('role' in request.resource.data) || request.resource.data.role == 'USER');
      
      // Regular user cannot change their own isAdmin, role, uid, or email
      allow update: if isAdmin() ||
                       (isOwner(userId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'role', 'uid', 'email']));
      
      allow delete: if isAdmin();
    }

    // ─── stations ────────────────────────────────────────────────────────────
    // Anyone authenticated can read stations.
    // Admins can manage all station data.
    // Regular users can only update availableBicycles count during booking/return transactions.
    match /stations/{stationId} {
      allow read:   if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
                       (isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableBicycles']));
      allow delete: if isAdmin();
    }

    // ─── bicycles ────────────────────────────────────────────────────────────
    // Anyone authenticated can read bicycles.
    // Admins have full CRUD. Handlers can update maintenance and station allocations.
    // Authenticated users can only update availability, status, and location during transactions.
    // Core properties (bicycleId, qrCode, type, imageUrl) are protected from customer modification.
    match /bicycles/{bicycleId} {
      allow read:   if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || isHandler() ||
                       (isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                          ['available', 'status', 'stationId', 'stationName', 'lastLocation', 'lastLocationTime', 'suspectedTheft']
                        ));
      allow delete: if isAdmin();
    }

    // ─── bookings ────────────────────────────────────────────────────────────
    // Users can read their own bookings. Admins and Handlers can read all bookings.
    // Create: Users can only create their own booking, with initial status 'PENDING'.
    // Update: Owner can update ride tracking fields, but CANNOT reassign ownership or bicycleId.
    // Delete: Strictly restricted to Admin to protect financial audit trails.
    match /bookings/{bookingId} {
      allow read:   if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isHandler() || isAdmin());
      
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'PENDING';
      
      allow update: if isAdmin() || isHandler() ||
                       (isAuthenticated() &&
                        resource.data.userId == request.auth.uid &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'bicycleId', 'createdAt']));
      
      allow delete: if isAdmin();
    }

    // ─── payments ────────────────────────────────────────────────────────────
    // Users can read only their own payments. Admins can read all.
    // Payments must belong to the authenticated user.
    // Deletion and updates are restricted to Admins.
    match /payments/{paymentId} {
      allow read:   if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isAuthenticated() &&
                       (request.resource.data.userId == request.auth.uid || !('userId' in request.resource.data));
      
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── pricing_config ───────────────────────────────────────────────────────
    // All authenticated users can read the current pricing rates.
    // Only Administrators can update or configure pricing.
    match /pricing_config/{configId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── coupons ──────────────────────────────────────────────────────────────
    // Customers can read active coupons to apply promotional discounts.
    // Only Administrators can create, edit, or delete coupons.
    match /coupons/{couponId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── invoices ─────────────────────────────────────────────────────────────
    // Customers can read their own invoices; Admins can view all.
    // Customers can create an invoice record upon completing a ride.
    // Deletions and modifications are restricted to Admins to maintain audit trails.
    match /invoices/{invoiceId} {
      allow read:   if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
